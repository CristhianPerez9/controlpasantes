# ============================================================================
# CONFIGURACIÓN DE ENTORNO SEGURA - NO COMMITEAR ARCHIVOS .env CON SECRETOS
# ============================================================================
# Copiar a .env.local y completar con valores reales
# .env.local NUNCA debe ser commiteado al repositorio

# Django Security
DEBUG=False
DJANGO_SECRET_KEY=tu-clave-secreta-django-aqui-64-caracteres-minimo
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,pasantes.comteco.com.bo
CSRF_TRUSTED_ORIGINS=http://localhost:8000,https://pasantes.comteco.com.bo

# PostgreSQL Database
POSTGRES_DB=asistencia_db
POSTGRES_USER=pasantes
POSTGRES_PASSWORD=contraseña-segura-aqui-minimo-30-caracteres
POSTGRES_HOST=192.9.200.162
POSTGRES_PORT=5432

# LDAP Authentication
LDAP_SERVER=ldap://192.9.200.51:389
LDAP_USER_BASE=dc=comteco,dc=net
LDAP_DOMAIN=COMTECO

# Static Files
STATIC_ROOT=/app/staticfiles

# Superusuario (solo para desarrollo - NO usar en producción)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@comteco.com.bo
DJANGO_SUPERUSER_PASSWORD=contraseña-segura-admin-aqui

# Logging
LOG_LEVEL=INFO
